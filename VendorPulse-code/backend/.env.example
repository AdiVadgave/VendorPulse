# VendorPulse Backend — environment variables
# Copy to .env and adjust values before running

# ── Microsoft Graph API ────────────────────────────────────────────────────
# Required for Graph-based meeting scheduling integration.
# Get token from https://developer.microsoft.com/en-us/graph/graph-explorer
# Token format: Bearer token (JWT) — expires in ~1 hour
# For production, implement OAuth2 flow with client credentials.
GRAPH_ACCESS_TOKEN=

# ── LLM — set ENABLE_LLM=true and add your OpenAI key to activate agents ──
ENABLE_LLM=false
OPENAI_API_KEY=sk-...

# ── Data directory (defaults to ./data relative to app/) ──────────────────
# DATA_DIR=/absolute/path/to/data
