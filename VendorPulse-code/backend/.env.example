# VendorPulse Backend — environment variables
# Copy to .env and adjust values before running

# ── Database (PostgreSQL — required) ────────────────────────────────────────
# The app stores every entity in Postgres (one JSONB table per entity) and will
# not start without a reachable database. Provide either a full DSN...
#   DATABASE_URL=postgresql://user:pass@host:5432/vendorpulse?sslmode=require
# ...or the individual parts (used only when DATABASE_URL is empty):
DATABASE_URL=
PG_HOST=
PG_PORT=5432
PG_DATABASE=vendorpulse
PG_USER=
PG_PASSWORD=
# Azure Database for PostgreSQL requires SSL. Use "disable" only for a local box.
PG_SSLMODE=require
PG_POOL_MIN=1
PG_POOL_MAX=10

# ── Microsoft Graph API ────────────────────────────────────────────────────
# Required for Graph-based meeting scheduling integration.
# Get token from https://developer.microsoft.com/en-us/graph/graph-explorer
# Token format: Bearer token (JWT) — expires in ~1 hour
# For production, implement OAuth2 flow with client credentials.
GRAPH_ACCESS_TOKEN=

# ── LLM — set ENABLE_LLM=true and add your OpenAI key to activate agents ──
ENABLE_LLM=false
OPENAI_API_KEY=sk-...

# ── Legacy JSON data directory (defaults to ./data relative to app/) ───────
# No longer the live store — read only by scripts/migrate_json_to_postgres.py
# to seed Postgres from the historical *.json files.
# DATA_DIR=/absolute/path/to/data
