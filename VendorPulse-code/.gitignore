# ─────────────────────────────────────────────────────────────────────────────
# VendorPulse — .gitignore
# NEVER commit secrets, credentials, certificates, tokens, logs, or local data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & credentials (CRITICAL — never commit) ──────────────────────────
.env
.env.*
!.env.example
*.local
frontend/.env.local
backend/.env

# Certificates / private keys
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
secrets/
backend/secrets/

# OAuth / API tokens & credential files
**/google_token.json
**/*token*.json
**/credential*.json
**/*credentials*.json
**/client_secret*.json

# ── Local application data & logs (may contain PII) ──────────────────────────
data/
backend/data/
logs/
backend/logs/
*.log

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Deployment build output (frontend copied into backend/static) ────────────
backend/static/

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
