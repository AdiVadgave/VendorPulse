# VendorPulse Backend — environment variables
# Copy to .env and adjust values before running

# ── Teams Backend integration ──────────────────────────────────────────────
# Set USE_TEAMS_BACKEND=true to proxy user data and mirror meetings to the
# Teams backend (http://localhost:3001). All users, availability, and created
# meetings will be stored in teams-backend/data/ as the single source of truth.
USE_TEAMS_BACKEND=true
TEAMS_BACKEND_URL=http://localhost:3001

# ── LLM (disabled by default) ─────────────────────────────────────────────
ENABLE_LLM=false
ANTHROPIC_API_KEY=

# ── Data directory (defaults to ./data relative to app/) ──────────────────
# DATA_DIR=/absolute/path/to/data
