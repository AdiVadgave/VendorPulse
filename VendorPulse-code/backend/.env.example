# VendorPulse Backend — environment variables
# Copy to .env and fill in real values. Never commit .env (it holds secrets).

# ── Database (PostgreSQL — required) ────────────────────────────────────────
# The app stores every entity in Postgres and will not start without a reachable
# database. Provide either a full DSN...
#   DATABASE_URL=postgresql://<user>:<password>@<host>:5432/vendorpulse?sslmode=require
# ...or the individual parts (used only when DATABASE_URL is empty):
DATABASE_URL=
PG_HOST=
PG_PORT=5432
PG_DATABASE=vendorpulse
PG_USER=
PG_PASSWORD=
# Azure Database for PostgreSQL requires SSL. Use "disable" only for a local box.
PG_SSLMODE=require
PG_POOL_MIN=1
PG_POOL_MAX=10

# ── Mail — Microsoft Graph (service mailbox, app-only Mail.Send + certificate) ──
# All outbound mail (scorecard links, meeting minutes) sends via this mailbox.
# Gmail has been removed. See docs/MAIL_SEND_IMPLEMENTATION.md.
MAIL_PROVIDER=graph
GRAPH_MAIL_SENDER=Mobility-VendorPulse@shell.com
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
GRAPH_CERT_PATH=          # path to the SPN .pfx (private key), kept out of version control
GRAPH_CERT_PASSWORD=      # PFX password (empty for a Key Vault export)
GRAPH_CERT_THUMBPRINT=    # optional — derived from the cert if blank

# ── LLM — set ENABLE_LLM=true and add credentials to activate the agents ────
ENABLE_LLM=false
AI_PROVIDER=azure          # "azure" | "openai"
# Azure OpenAI (used when AI_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Standard OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=

# ── Authentication (Entra ID SSO) ────────────────────────────────────────────
# PRODUCTION: set SSO_ENABLED=true and provide the SPA app registration ids, so
# every API call must present a valid Entra ID bearer token (401 otherwise).
# With SSO off the API is open (dev principal) — intended for local dev only.
SSO_ENABLED=false
SSO_CLIENT_ID=
SSO_TENANT_ID=
# SSO_EXTRA_AUDIENCES=

# ── Optional ────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed by CORS (defaults to localhost dev ports).
# CORS_ORIGINS=http://localhost:5173
#
# Delegated Graph token for BEST-EFFORT calendar/Teams event cancel in the
# alignment / vendor-prep flows. Optional — those operations are simply skipped
# when it is blank. A delegated token expires; leave empty unless you need it.
# GRAPH_ACCESS_TOKEN=
#
# Legacy JSON seed directory — read only by scripts/migrate_json_to_postgres.py.
# DATA_DIR=/absolute/path/to/data
